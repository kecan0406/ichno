{
  "name": "ichno",
  "version": "0.1.0",
  "description": "Seat floor plans for React: a Seats.io-level JSON document with a zod schema, geometry, a renderer-independent interaction core and a headless editor hook.",
  "keywords": [
    "seat-map",
    "floor-plan",
    "seating",
    "react",
    "svg",
    "editor"
  ],
  "license": "MIT",
  "author": "kecan0406",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kecan0406/ichno.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema/index.js",
    "./editor": "./dist/editor/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:compiler": "node scripts/check-compiler.mjs",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm check:compiler && pnpm build && pnpm check:pkg",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.17",
    "babel-plugin-react-compiler": "^1.0.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
